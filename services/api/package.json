{
  "name": "@vana/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.ts --passWithNoTests",
    "lint": "eslint src/",
    "clean": "rm -rf dist/",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/utils/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^6.9.0",
    "@types/nodemailer": "^8.0.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jose": "^6.0.11",
    "libsodium-wrappers-sumo": "^0.7.15",
    "mongoose": "^8.14.3",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.8.0",
    "twilio": "^5.7.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.25.0",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
