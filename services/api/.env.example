# =============================================
# V.A.N.A (Vigilant Assistance for NER Areas)
# Smart Tourist Safety Web Portal
# Environment Configuration
# =============================================

# Server
NODE_ENV=development
PORT=4000
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (+ PostGIS)
DATABASE_URL=postgresql://vana:vana_dev@localhost:5432/vana_dev?schema=public

# MongoDB
MONGODB_URI=mongodb://localhost:27017/vana_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=change_me_access_secret_64hex
JWT_REFRESH_SECRET=change_me_refresh_secret_64hex
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Encryption (X25519 server keypair — generate at first run)
SERVER_ENCRYPTION_SEED=change_me_32byte_hex_seed

# Mapbox
MAPBOX_ACCESS_TOKEN=

# Google Cloud Vision (Passport OCR)
GOOGLE_CLOUD_VISION_API_KEY=

# Gemini API (AI Summaries)
GEMINI_API_KEY=

# Weather
OPENWEATHER_API_KEY=

# Fares
NUMBEO_API_KEY=

# SMS — Hybrid routing
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=VANA

# SMS Gateway number (for inbound SOS SMS)
SOS_SMS_GATEWAY_NUMBER=

# DigiLocker
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# Polygon ID
POLYGON_ID_ISSUER_URL=

# Sentry
SENTRY_DSN=

# Pilot Region
PILOT_REGION=NER
PILOT_STATES=Meghalaya,Sikkim
